+# Soong only accepts letters, digits and _ . @ + - in a module name
+MODULE_NAME_CHARS = {
+    '[': 'lbracket',
+    ']': 'rbracket',
+    '(': 'lparen',
+    ')': 'rparen',
+    '{': 'lbrace',
+    '}': 'rbrace',
+    '*': 'star',
+    '?': 'question',
+    '|': 'pipe',
+    '<': 'lt',
+    '>': 'gt',
+    '!': 'bang',
+    ';': 'semicolon',
+    "'": 'apos',
+    '"': 'quote',
+    '\\': 'backslash',
+    ' ': 'space',
+}
+
+MODULE_NAME_ALLOWED = set('abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.@+-')
+
+
+def sanitize_module_name(name: str) -> str:
+    return ''.join(
+        char if char in MODULE_NAME_ALLOWED else MODULE_NAME_CHARS.get(char, '_')
+        for char in name
+    )
+
+
+def module_name_from_path(path: str) -> str:
+    return sanitize_module_name(path.replace('/', '_').replace('.', '_'))
+
+
