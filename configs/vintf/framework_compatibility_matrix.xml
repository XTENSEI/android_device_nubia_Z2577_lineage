<compatibility-matrix version="9.0" type="framework">
    <!-- The vendor sensors service is AIDL v1, the current platform matrices start at v2 -->
    <hal format="aidl" optional="true">
        <name>android.hardware.sensors</name>
        <interface>
            <name>ISensors</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- TEE entry point for the keymint, gatekeeper and identity services -->
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.trusty</name>
        <interface>
            <name>ITrustyClientProvider</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.boot</name>
        <version>1.2</version>
        <interface>
            <name>IBootControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.connmgr</name>
        <version>1.0</version>
        <interface>
            <name>IConnmgr</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.thermal</name>
        <version>1.0</version>
        <interface>
            <name>IExtThermal</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.thermal</name>
        <version>2.0</version>
        <interface>
            <name>IExtThermal</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.cplog_svc</name>
        <version>1</version>
        <interface>
            <name>ILogTransportInductor</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>ISysLogControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.enhance</name>
        <version>1</version>
        <interface>
            <name>IEnhance</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.gnss</name>
        <version>1</version>
        <interface>
            <name>IUnisocGnss</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.hdcp</name>
        <version>1</version>
        <interface>
            <name>IHDCP</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.network</name>
        <version>1</version>
        <interface>
            <name>INetworkControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.tool</name>
        <version>1</version>
        <interface>
            <name>IToolControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.sprd.hardware.unipnp</name>
        <version>1</version>
        <interface>
            <name>IUnionPnP</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.tms.tmsnfc_aidl</name>
        <version>1</version>
        <interface>
            <name>ITmsNfc</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.unisoc.hardware.ai_engine</name>
        <version>2</version>
        <interface>
            <name>IAIEngineControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.zte.ldd.cmd</name>
        <version>2</version>
        <interface>
            <name>IZteLddCmd</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.zte.subsys</name>
        <version>1</version>
        <interface>
            <name>ISubsys</name>
            <instance>subsys</instance>
        </interface>
    </hal>
    <sepolicy>
        <kernel-sepolicy-version>30</kernel-sepolicy-version>
        <sepolicy-version>29.0</sepolicy-version>
        <sepolicy-version>30.0</sepolicy-version>
        <sepolicy-version>31.0</sepolicy-version>
        <sepolicy-version>32.0</sepolicy-version>
        <sepolicy-version>33.0</sepolicy-version>
        <sepolicy-version>34.0</sepolicy-version>
        <sepolicy-version>202404</sepolicy-version>
        <sepolicy-version>202504</sepolicy-version>
    </sepolicy>
    <avb>
        <vbmeta-version>1.0</vbmeta-version>
    </avb>
</compatibility-matrix>
