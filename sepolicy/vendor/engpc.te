# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type engpc, domain;

type engpc_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(engpc)

allow engpc engpc_exec:file { read getattr map execute open entrypoint };
