# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_sensors_default hal_sensors_default_exec:file { read getattr map execute open entrypoint };
allow hal_sensors_default fwk_scheduler_hwservice:hwservice_manager find;
allow hal_sensors_default input_device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_sensors_default input_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_sensors_default hal_graphics_allocator_default:fd use;
allow hal_sensors_default ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_sensors_default dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_sensors_default sysfs_wake_lock:file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_sensors_default self:capability2 block_suspend;
allow hal_sensors_default self:cap2_userns block_suspend;
allow hal_sensors_default system_suspend_server:binder { call transfer };
allow hal_sensors_default system_suspend_server:fd use;
allow hal_sensors_default system_suspend_hwservice:hwservice_manager find;
allow hal_sensors_default hwservicemanager:binder { call transfer };
allow hal_sensors_default hwservicemanager_prop:file { read getattr map open };
allow hal_sensors_default hidl_manager_hwservice:hwservice_manager find;
allow hal_sensors_default hal_system_suspend_service:service_manager find;
allow hal_sensors_default servicemanager:binder { call transfer };
allow hal_sensors_default system_server:fd use;
allow hal_sensors_default sysfs:file { read write getattr open };
allow hal_sensors_default sysfs:dir { read open search };
allow hal_sensors_default sysfs_sensor:dir { read open search };
allow hal_sensors_default sysfs_sensor:file { read write open };
allow hal_sensors_default sensorhub_data_file:dir { read write getattr open add_name search };
allow hal_sensors_default prod_file:dir search;
allow hal_sensors_default sensorhub_data_file:file { read write create getattr setattr open };
allow hal_sensors_default mnt_vendor_file:dir search;
allow hal_sensors_default vendor_data_file:dir { write add_name };
allow hal_sensors_default vendor_data_file:file { write create getattr setattr open };
allow hal_sensors_default sysfs_sensor:lnk_file { read write create open };
allow hal_sensors_default iio_device:dir { read open search };
allow hal_sensors_default iio_device:chr_file { ioctl read write getattr setattr open };
allow hal_sensors_default property_socket:sock_file write;
allow hal_sensors_default input_device:dir { read open };
allow hal_sensors_default input_device:chr_file { ioctl read open };
allow hal_sensors_default sensors_device:chr_file { ioctl read open };
allow hal_sensors_default sysfs:file { read write open };
allow hal_sensors_default input_device:dir search;
allow hal_sensors_default prod_file:dir { read write create open add_name search };
allow hal_sensors_default prod_file:file { read write create getattr setattr open };
allow hal_sensors_default mnt_vendor_file:dir { read open search };
allow hal_sensors_default engpc:fd use;
allow hal_sensors_default system_server:binder call;
allow hal_sensors_default engpc:binder call;
allow hal_sensors_default hal_graphics_allocator_default_tmpfs:file { read write };
allow hal_sensors_default vendor_dynamic_sensor_prop:file { read getattr map open };
allow hal_sensors_default device:dir { ioctl read getattr lock open watch watch_reads search };
allow hal_sensors_default hidraw_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_sensors_default cameraserver:binder { call transfer };
allow hal_sensors_default camera_config_prop:file { read getattr map open };
allow hal_sensors_default hidl_token_hwservice:hwservice_manager find;
allow hal_sensors_default fwk_camera_hwservice:hwservice_manager find;
allow hal_sensors_default cameraserver:fd use;
allow hal_sensors_default camera_service_server:binder { call transfer };
allow hal_sensors_default camera_service_server:fd use;
allow hal_sensors_default camera_service_server:binder transfer;
allow hal_sensors_default gpu_device:chr_file { ioctl read write map open };
allow hal_sensors_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_sensors_default hal_graphics_allocator_default:binder { call transfer };
allow hal_sensors_default hal_graphics_allocator_hwservice:hwservice_manager find;
allow hal_sensors_default hal_graphics_allocator_default:binder call;
allow hal_sensors_default hal_graphics_allocator_service:service_manager find;
allow hal_sensors_default vendor_sensors_prop:file { read getattr map open };
allow hal_sensors_default init:unix_stream_socket connectto;
allow hal_sensors_default vendor_sensors_prop:property_service set;
allow hal_sensors_default coredump_file:dir { read write getattr open add_name remove_name search };
allow hal_sensors_default coredump_file:file { read write create getattr setattr unlink open };
allow hal_sensors_default vendor_sensor_test_prop:file { read getattr open };
allow hal_sensors_default vendor_sensor_test_prop:property_service set;
allow hal_sensors_default proc:file { read getattr open };
allow hal_sensors_default sys_proc:file { read getattr open };
allow hal_sensors_default sysfs_sarstatus_file:dir search;
allow hal_sensors_default sysfs_sarstatus_file:file { read write open };
allow hal_sensors_default zlog_device:chr_file { write open };
allow hal_sensors_default sysfs_power:dir search;
allow hal_sensors_default sysfs_power:file { read open };
