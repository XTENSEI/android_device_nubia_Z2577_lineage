# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_graphics_composer_default hal_graphics_composer_default_exec:file { read getattr map execute open entrypoint };
type_transition hal_graphics_composer_default tmpfs:file hal_graphics_composer_server_tmpfs;
allow hal_graphics_composer_default hal_graphics_composer_server_tmpfs:file { read write getattr map };
dontaudit hal_graphics_composer_default unlabeled:dir search;
allow hal_graphics_composer_default systemheap_device:chr_file { ioctl read write open };
allow hal_graphics_composer_default vndbinder_device:chr_file { ioctl read write map open };
allow hal_graphics_composer_default boot_status_prop:file { read getattr map open };
allow hal_graphics_composer_default hal_graphics_composer_default:netlink_kobject_uevent_socket { read create bind };
allow hal_graphics_composer_default sysfs:file { read write getattr open };
allow hal_graphics_composer_default block_device:dir search;
allow hal_graphics_composer_default logo_block_device:blk_file { read write getattr open };
allow hal_graphics_composer_default hal_graphics_allocator_default_tmpfs:file { read write getattr map };
allow hal_graphics_composer_default device:dir { read open };
allow hal_graphics_composer_default hal_graphics_allocator_default:binder call;
allow hal_graphics_composer_default hal_graphics_allocator_hwservice:hwservice_manager find;
allow hal_graphics_composer_default hal_configstore_ISurfaceFlingerConfigs:hwservice_manager find;
allow hal_graphics_composer_default ion_device:chr_file write;
allow hal_graphics_composer_default system_data_file:dir search;
allow hal_graphics_composer_default vndbinder_device:chr_file { ioctl read write open };
allow hal_graphics_composer_default prod_file:dir { write add_name search };
allow hal_graphics_composer_default prod_file:file { read write create open };
allow hal_graphics_composer_default vendor_camera_prop:file { read getattr map open };
allow hal_graphics_composer_default hal_configstore_default:binder call;
allow hal_graphics_composer_default sysfs:file { read write open };
allow hal_graphics_composer_default vendor_hwc_prop:file { read getattr map open };
allow hal_graphics_composer_default vendor_gpu_prop:file { read getattr map open };
allow hal_graphics_composer_default vendor_arm_prop:file { read getattr map open };
allow hal_graphics_composer_default vendor_powerhint_prop:file { read getattr map open };
allow hal_graphics_composer_default hwc_stat_file:file { read write getattr open };
allow hal_graphics_composer_default hwc_stat_file:dir search;
allow hal_graphics_composer_default hal_power_hwservice:hwservice_manager find;
allow hal_graphics_composer_default hal_power_default:binder { call transfer };
allow hal_graphics_composer_default hal_enhanceaidl_service:service_manager find;
allow hal_graphics_composer_default hal_enhanceaidl_default:binder call;
allow hal_graphics_composer_default vendor_data_file:dir { write create getattr open add_name remove_name search };
allow hal_graphics_composer_default vendor_data_file:file { read write create getattr open };
allow hal_graphics_composer_default sysfs_ddr_dfs:file { write open };
allow hal_graphics_composer_default sysfs_ddr_dfs:dir search;
allow hal_graphics_composer_default property_socket:sock_file write;
allow hal_graphics_composer_default init:unix_stream_socket connectto;
allow hal_graphics_composer_default vendor_hwc_prop:property_service set;
allow hal_graphics_composer_default proc_fgp_set:file { read write getattr open };
