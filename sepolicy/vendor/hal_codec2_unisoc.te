# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_codec2_unisoc, domain;
hal_server_domain(hal_codec2_unisoc, hal_codec2)

type hal_codec2_unisoc_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_codec2_unisoc)

allow hal_codec2_unisoc hal_codec2_unisoc_exec:file { read getattr map execute open entrypoint };
allow hal_codec2_unisoc vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_codec2_unisoc vndservicemanager:binder { call transfer };
allow hal_codec2_unisoc gpu_device:chr_file { ioctl read write map open };
allow hal_codec2_unisoc gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_codec2_unisoc ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_codec2_unisoc system_data_file:dir search;
allow hal_codec2_unisoc video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_codec2_unisoc video_device:dir search;
allow hal_codec2_unisoc video_device:chr_file { ioctl read write map open };
allow hal_codec2_unisoc vendor_data_file:dir { write create getattr open add_name remove_name search };
allow hal_codec2_unisoc vendor_data_file:file { read write create getattr open };
allow hal_codec2_unisoc debugfs_binder:file { read open };
allow hal_codec2_unisoc servicemanager:binder call;
allow hal_codec2_unisoc hal_power_service:service_manager find;
allow hal_codec2_unisoc hal_power_default:binder { call transfer };
allow hal_codec2_unisoc property_socket:sock_file write;
allow hal_codec2_unisoc init:unix_stream_socket connectto;
allow hal_codec2_unisoc vendor_video_prop:property_service set;
allow hal_codec2_unisoc vendor_video_prop:file { read getattr map open };
allow hal_codec2_unisoc anr_data_file:file append;
allow hal_codec2_unisoc dumpstate:fd use;
allow hal_codec2_unisoc incidentd:fd use;
allow hal_codec2_unisoc dumpstate:fifo_file { write append };
allow hal_codec2_unisoc incidentd:fifo_file { write append };
allow hal_codec2_unisoc system_server:fifo_file { write append };
allow hal_codec2_unisoc tombstoned:unix_stream_socket connectto;
allow hal_codec2_unisoc tombstoned:fd use;
allow hal_codec2_unisoc tombstoned_crash_socket:sock_file write;
allow hal_codec2_unisoc tombstone_data_file:file append;
allow hal_codec2_unisoc map_device:chr_file { ioctl read write map open };
allow hal_codec2_unisoc dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_codec2_unisoc sprd_img_device:chr_file { ioctl read write map open };
allow hal_codec2_unisoc vendor_pvr_prop:file { read getattr map open };
allow hal_codec2_unisoc teetz_device:chr_file { ioctl read write open };
allow hal_codec2_unisoc logdr_socket:sock_file { read write getattr };
allow hal_codec2_unisoc logdr_socket:dir { read getattr map open search };
allow hal_codec2_unisoc system_data_file:dir { getattr search };
allow hal_codec2_unisoc proc_uptime:file { read getattr open };
allow hal_codec2_unisoc logd:unix_stream_socket connectto;
allow hal_codec2_unisoc hal_trustyclientaidl_default:binder { call transfer };
allow hal_codec2_unisoc hal_trustyclientaidl_default:fd use;
allow hal_codec2_unisoc hal_trustyclientaidl_service:service_manager find;
