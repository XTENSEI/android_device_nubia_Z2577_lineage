# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type gpsd, domain;

type gpsd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(gpsd)

allow gpsd gpsd_exec:file { read getattr map execute open entrypoint };
allow gpsd sysfs_wake_lock:file { read write open };
allow gpsd serial_device:chr_file { ioctl read write open };
allow gpsd tmpfs:dir { write add_name };
allow gpsd gnss_file:dir { read write create open add_name remove_name search };
allow gpsd gnss_file:file { read write create getattr setattr append unlink open };
allow gpsd shell:netlink_socket { read write create };
allow gpsd socket_device:sock_file write;
allow gpsd wcn_device:chr_file { ioctl read write open };
allow gpsd vendor_shell_exec:file execute;
allow gpsd self:netlink_route_socket nlmsg_write;
allow gpsd dnsproxyd_socket:sock_file write;
allow gpsd vendor_audio_prop:file { read getattr map open };
allow gpsd vendor_media_prop:file { read getattr map open };
allow gpsd vendor_radio_prop:file { read getattr map open };
allow gpsd sysfs_gnss:dir { read open search };
allow gpsd sysfs_gnss:file { ioctl read write open };
allow gpsd sysfs_wcn:dir search;
allow gpsd sysfs_wcn:file { read open };
allow gpsd hal_gnss_ext_default:unix_dgram_socket sendto;
allow gpsd tty_device:chr_file { ioctl read write open };
allow gpsd sensors_device:chr_file { ioctl read write open };
allow gpsd prod_file:dir { write create open add_name remove_name search };
allow gpsd prod_file:file { read write create getattr setattr append open };
allow gpsd port:tcp_socket name_connect;
allow gpsd self:tcp_socket { ioctl read write create bind connect getopt setopt };
allow gpsd fwmarkd_socket:sock_file write;
allow gpsd netd:unix_stream_socket connectto;
allow gpsd engpc:unix_dgram_socket sendto;
allow gpsd gpsd:netlink_kobject_uevent_socket { read create bind getopt setopt };
allow gpsd wcnd:unix_stream_socket connectto;
allow gpsd sysfs:dir { read open };
allow gpsd sysfs:file { read open };
allow gpsd hwservicemanager_prop:file { read getattr map open };
allow gpsd fwk_sensor_hwservice:hwservice_manager find;
allow gpsd hwservicemanager:binder call;
allow gpsd system_server:binder { call transfer };
