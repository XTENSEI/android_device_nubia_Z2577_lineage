# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_power_default hal_power_default_exec:file { read getattr map execute open entrypoint };
allow hal_power_default hal_audio_default:binder transfer;
allow hal_power_default power_device:chr_file { read write open };
allow hal_power_default cgroup:file { read write open };
allow hal_power_default self:capability sys_admin;
allow hal_power_default sysfs_ddr_dfs:dir search;
allow hal_power_default sysfs_ddr_dfs:file { read write open };
allow hal_power_default sysfs:file { read write open };
allow hal_power_default sysfs_devices_system_cpu:file { write open };
allow hal_power_default hal_health_hwservice:hwservice_manager find;
allow hal_power_default hal_health_default:binder { call transfer };
allow hal_power_default hal_health_default:fd use;
allow hal_power_default hal_health_default:binder transfer;
allow hal_power_default property_socket:sock_file write;
allow hal_power_default init:unix_stream_socket connectto;
allow hal_power_default vendor_power_prop:property_service set;
allow hal_power_default vendor_power_prop:file { read getattr map open };
allow hal_power_default sysfs_lowmemorykiller:dir search;
allow hal_power_default sysfs_lowmemorykiller:file { read write open };
allow hal_power_default proc_drop_caches:file { read write open };
allow hal_power_default proc:file { read write open };
allow hal_power_default hal_codec2_unisoc:binder transfer;
allow hal_power_default proc_watermark_scale_factor:file { read write open };
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default self:capability sys_nice;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default system_server:process setsched;
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default su:process setsched;
