# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_connmgr_default, domain;

type hal_connmgr_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_connmgr_default)

allow hal_connmgr_default hal_connmgr_default_exec:file { read getattr map execute open entrypoint };
allow hal_connmgr_default system_app:binder transfer;
allow hal_connmgr_default hal_connmgr_hwservice:hwservice_manager { add find };
allow hal_connmgr_default hwservicemanager:binder { call transfer };
allow hal_connmgr_default hwservicemanager_prop:file { read getattr map open };
allow hal_connmgr_default hidl_base_hwservice:hwservice_manager add;
allow hal_connmgr_default wcnd:unix_stream_socket { read write getattr sendto connectto };
