# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type slogmodem_vendor, domain;
typeattribute slogmodem_vendor mlstrustedsubject;

type slogmodem_vendor_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(slogmodem_vendor)

allow slogmodem_vendor slogmodem_vendor_exec:file { read getattr map execute open entrypoint };
allow slogmodem_vendor property_socket:sock_file { read write };
allow slogmodem_vendor spipe_device:chr_file { read write open };
allow slogmodem_vendor sipc_debug_device:chr_file { read open };
allow slogmodem_vendor slog_device:chr_file { ioctl read write map open };
allow slogmodem_vendor slog_device:file { read open };
allow slogmodem_vendor audio_device:chr_file { ioctl read write open };
allow slogmodem_vendor etb_device:chr_file { ioctl read open };
allow slogmodem_vendor init:unix_stream_socket connectto;
allow slogmodem_vendor modem_control:unix_stream_socket { read write connectto };
allow slogmodem_vendor wcnd:unix_stream_socket { read write connectto };
allow slogmodem_vendor refnotify:unix_stream_socket { read write connectto };
allow slogmodem_vendor ctl_default_prop:property_service set;
allow slogmodem_vendor proc:file { read write getattr open };
allow slogmodem_vendor proc_pmicmem:file { read write getattr open };
allow slogmodem_vendor proc_cptlmem:file { read write getattr open };
allow slogmodem_vendor proc_pmicpmsys:file { read write getattr open };
allow slogmodem_vendor block_device:dir search;
allow slogmodem_vendor mmcblk_device:blk_file { read open };
allow slogmodem_vendor userdata_block_device:blk_file { read open };
allow slogmodem_vendor slogmodem_vendor:netlink_kobject_uevent_socket { read create bind getopt };
allow slogmodem_vendor tty_device:chr_file { read write open };
allow slogmodem_vendor storage_file:dir { write unlink add_name search };
allow slogmodem_vendor storage_file:lnk_file { read write create getattr unlink open };
allow slogmodem_vendor mnt_media_rw_file:dir { read write open search };
allow slogmodem_vendor vfat:dir { read write create getattr unlink open add_name remove_name search rmdir };
allow slogmodem_vendor vfat:file { read write create getattr map unlink rename open };
allow slogmodem_vendor exfat:dir { read write create getattr unlink open add_name remove_name search rmdir };
allow slogmodem_vendor exfat:file { read write create getattr map unlink rename open };
allow slogmodem_vendor slogmodem_vendor_data:dir { read write create getattr unlink open add_name remove_name search rmdir };
allow slogmodem_vendor slogmodem_vendor_data:file { read write create getattr append map unlink rename open };
allow slogmodem_vendor fuse:dir { read write create getattr unlink open add_name remove_name search rmdir };
allow slogmodem_vendor fuse:file { read write create getattr map unlink rename open };
allow slogmodem_vendor slogmodem_vendor_config_file:dir { write unlink add_name remove_name search };
allow slogmodem_vendor slogmodem_vendor_config_file:file { read write create getattr unlink open };
allow slogmodem_vendor tmpfs:dir search;
allow slogmodem_vendor rootfs:dir { read open };
allow slogmodem_vendor debugfs_sipc:dir { read getattr open search };
allow slogmodem_vendor gnss_file:dir { read open search };
allow slogmodem_vendor gnss_file:file { read getattr open };
allow slogmodem_vendor sysfs:file { read open };
allow slogmodem_vendor sysfs_iq:file { read open };
allow slogmodem_vendor mnt_user_file:dir { read write create getattr unlink open add_name remove_name search rmdir };
allow slogmodem_vendor mnt_user_file:file { read write create getattr map unlink rename open };
allow slogmodem_vendor sdcardfs:dir { read write create getattr unlink open add_name remove_name search rmdir };
allow slogmodem_vendor sdcardfs:file { read write create getattr map unlink rename open };
allow slogmodem_vendor proc_cmdline:file { read getattr open };
allow slogmodem_vendor sysfs_wcn:dir search;
allow slogmodem_vendor sysfs_wcn:file { read getattr open };
allow slogmodem_vendor loader_device:chr_file { ioctl read write open };
allow slogmodem_vendor hwservicemanager_prop:file { read getattr map open };
allow slogmodem_vendor hwservicemanager:binder { call transfer };
allow slogmodem_vendor proc_bootconfig:file { read getattr open };
allow slogmodem_vendor hal_cplog_svcaidl_default:binder { call transfer };
allow slogmodem_vendor hal_cplog_svcaidl_service:service_manager find;
allow slogmodem_vendor servicemanager:binder call;
allow slogmodem_vendor vendor_ag_prop:file { read getattr map open };
allow slogmodem_vendor vendor_sp_prop:file { read getattr map open };
allow slogmodem_vendor vendor_ch_prop:file { read getattr map open };
allow slogmodem_vendor property_socket:sock_file write;
allow slogmodem_vendor vendor_radio_prop:property_service set;
allow slogmodem_vendor vendor_radio_prop:file { read getattr map open };
allow slogmodem_vendor vendor_engpc_prop:property_service set;
allow slogmodem_vendor vendor_engpc_prop:file { read getattr map open };
allow slogmodem_vendor vendor_modem_prop:property_service set;
allow slogmodem_vendor vendor_modem_prop:file { read getattr map open };
allow slogmodem_vendor vendor_product_prop:property_service set;
allow slogmodem_vendor vendor_product_prop:file { read getattr map open };
allow slogmodem_vendor vendor_sys_prop:property_service set;
allow slogmodem_vendor vendor_sys_prop:file { read getattr map open };
