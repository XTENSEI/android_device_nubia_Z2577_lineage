# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type uniber, domain;

type uniber_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(uniber)

allow uniber sysfs_devices_system_cpu:file { ioctl read getattr lock map open watch watch_reads };
allow uniber proc_interrupts:file { ioctl read getattr lock map open watch watch_reads };
allow uniber proc_stat:file { ioctl read getattr lock map open watch watch_reads };
allow uniber proc:file { ioctl read write getattr lock append map open watch watch_reads };
allow uniber kmsg_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow uniber uniber_exec:file { read getattr map execute open entrypoint };
