# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type modem_control, domain;
typeattribute modem_control mlstrustedsubject;

type modem_control_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(modem_control)

allow modem_control modem_control_exec:file { read getattr map execute open entrypoint };
allow modem_control sysfs:file { read write open };
allow modem_control sysfs:dir { read open };
allow modem_control sysfs_wake_lock:file { read write open };
allow modem_control init:unix_stream_socket connectto;
allow modem_control vendor_shell_exec:file { read getattr execute open execute_no_trans };
allow modem_control block_device:dir search;
allow modem_control mmcblk_device:blk_file { read write open };
allow modem_control ufs_device:blk_file { read write open };
allow modem_control userdata_block_device:blk_file { read write open };
allow modem_control bm_device:chr_file { ioctl read write open };
allow modem_control mpu_device:chr_file { ioctl read write getattr open };
allow modem_control slog_device:chr_file { read write open };
allow modem_control tty_device:chr_file { read write open };
allow modem_control proc_sysrq:file { read write create open };
allow modem_control cp_diskserver:dir search;
allow modem_control cp_diskserver:file { read open };
allow modem_control proc:file { read write setattr open };
allow modem_control proc_pmicpmsys:file { read write getattr open };
allow modem_control proc_mini_dump:file { read write getattr open };
allow modem_control proc_pubcpiram:file { read write getattr open };
allow modem_control proc_aoniram:file { read write getattr open };
allow modem_control proc_pmicmem:file { read write getattr open };
allow modem_control spipe_device:chr_file { read write open };
allow modem_control sysfs_spool:file { read open };
allow modem_control loader_device:chr_file { ioctl read write open };
allow modem_control self:capability2 block_suspend;
allow modem_control property_socket:sock_file { read write };
allow modem_control powerctl_prop:property_service set;
allow modem_control modem_control:capability { setgid setuid };
allow modem_control proc_cmdline:file { read open };
allow modem_control vendor_sys_prop:file { read getattr open };
allow modem_control kernel:system module_request;
allow modem_control vendor_sys_prop:file { read getattr map open };
allow modem_control ctl_start_prop:property_service set;
allow modem_control ctl_stop_prop:property_service set;
allow modem_control vendor_sys_prop:property_service set;
allow modem_control slogmodem_vendor_data:dir { write add_name search };
allow modem_control slogmodem_vendor_data:file { read write create getattr append open };
allow modem_control proc_bootconfig:file { read write getattr open };
allow modem_control property_socket:sock_file write;
allow modem_control vendor_radio_prop:property_service set;
allow modem_control vendor_radio_prop:file { read getattr map open };
allow modem_control vendor_product_prop:property_service set;
allow modem_control vendor_product_prop:file { read getattr map open };
allow modem_control vendor_modem_prop:property_service set;
allow modem_control vendor_modem_prop:file { read getattr map open };
allow modem_control vendor_sp_prop:file { read getattr map open };
allow modem_control vendor_ch_prop:file { read getattr map open };
allow modem_control teetz_device:chr_file { ioctl read write open };
