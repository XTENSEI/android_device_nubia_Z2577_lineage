# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_cplog_svcaidl_default, domain;
typeattribute hal_cplog_svcaidl_default mlstrustedobject;

type hal_cplog_svcaidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_cplog_svcaidl_default)

allow hal_cplog_svcaidl_default dumpstate:binder transfer;
allow hal_cplog_svcaidl_default system_app:binder transfer;
allow hal_cplog_svcaidl_default hal_cplog_svcaidl_default_exec:file { read getattr map execute open entrypoint };
allow hal_cplog_svcaidl_default servicemanager:binder { call transfer };
allow hal_cplog_svcaidl_default hal_cplog_svcaidl_service:service_manager { add find };
allow hal_cplog_svcaidl_default hwservicemanager_prop:file { read getattr map open };
allow hal_cplog_svcaidl_default hwservicemanager:binder { call transfer };
allow hal_cplog_svcaidl_default vendor_data_file:file { read write create getattr unlink open };
allow hal_cplog_svcaidl_default vendor_data_file:dir { read write create open add_name remove_name };
allow hal_cplog_svcaidl_default spipe_device:chr_file { read write open };
allow hal_cplog_svcaidl_default vendor_radio_prop:file { read getattr map open };
allow hal_cplog_svcaidl_default tty_device:chr_file { read write open };
allow hal_cplog_svcaidl_default modem_control:unix_stream_socket { read write connectto };
allow hal_cplog_svcaidl_default hal_gnss_ext_default:binder call;
allow hal_cplog_svcaidl_default hal_extGnss_hwservice:hwservice_manager find;
allow hal_cplog_svcaidl_default hal_extGnss_service:service_manager find;
allow hal_cplog_svcaidl_default wcnd:unix_stream_socket { read write connectto };
allow hal_cplog_svcaidl_default refnotify:unix_stream_socket { read write connectto };
allow hal_cplog_svcaidl_default sysfs_wcn:dir search;
allow hal_cplog_svcaidl_default sysfs_wcn:file { read open };
allow hal_cplog_svcaidl_default vendor_sys_prop:file { read getattr map open };
allow hal_cplog_svcaidl_default property_socket:sock_file write;
allow hal_cplog_svcaidl_default init:unix_stream_socket connectto;
allow hal_cplog_svcaidl_default vendor_sys_prop:property_service set;
allow hal_cplog_svcaidl_default slogmodem:binder call;
allow hal_cplog_svcaidl_default slogmodem_vendor:binder call;
allow hal_cplog_svcaidl_default radio:binder call;
allow hal_cplog_svcaidl_default engpc:unix_stream_socket { read write connectto };
allow hal_cplog_svcaidl_default audio_device:chr_file { ioctl read write open };
allow hal_cplog_svcaidl_default vendor_shell_exec:file execute_no_trans;
allow hal_cplog_svcaidl_default exported_default_prop:file { read getattr open };
allow hal_cplog_svcaidl_default proc_cmdline:file { read getattr open };
allow hal_cplog_svcaidl_default proc_bootconfig:file { read getattr open };
allow hal_cplog_svcaidl_default sysfs_mipi:file { read write open };
allow hal_cplog_svcaidl_default slogmodem_vendor_data:dir search;
allow hal_cplog_svcaidl_default slogmodem_vendor_data:file { read create getattr unlink open };
allow hal_cplog_svcaidl_default boot_status_prop:file { read getattr map open };
allow hal_cplog_svcaidl_default vendor_ag_prop:file { read getattr map open };
allow hal_cplog_svcaidl_default vendor_sp_prop:file { read getattr map open };
allow hal_cplog_svcaidl_default vendor_ch_prop:file { read getattr map open };
