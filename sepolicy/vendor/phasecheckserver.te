# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type phasecheckserver, domain;
typeattribute phasecheckserver mlstrustedsubject;

type phasecheckserver_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(phasecheckserver)

allow phasecheckserver vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow phasecheckserver vndservicemanager:binder { call transfer };
allow phasecheckserver system_server:binder { call transfer };
allow phasecheckserver system_server:fd use;
allow phasecheckserver phasecheckserver:netlink_kobject_uevent_socket { read create bind setopt };
allow phasecheckserver self:capability net_admin;
allow phasecheckserver prod_file:dir { ioctl read write getattr lock append map open watch watch_reads add_name search };
allow phasecheckserver prod_file:file { ioctl read write getattr lock append map open watch watch_reads };
allow phasecheckserver sysfs:file { read write open };
allow phasecheckserver block_device:dir search;
allow phasecheckserver tmpfs:dir { write add_name };
allow phasecheckserver mmcblk_device:blk_file { read write getattr open };
allow phasecheckserver userdata_block_device:blk_file { read write getattr open };
allow phasecheckserver phasecheckserver_tmpfs:file create;
allow phasecheckserver sysfs_leds:dir search;
allow phasecheckserver sysfs_leds:file { read write open };
allow phasecheckserver property_socket:sock_file write;
allow phasecheckserver init:unix_stream_socket connectto;
allow phasecheckserver vendor_product_prop:property_service set;
allow phasecheckserver vendor_product_prop:file { read getattr map open };
allow phasecheckserver vendor_product_prop:file { read open };
allow phasecheckserver sysfs_power:dir search;
allow phasecheckserver sysfs_power:file { read write open };
allow phasecheckserver vendor_file:file execute_no_trans;
allow phasecheckserver vendor_shell_exec:file execute_no_trans;
allow phasecheckserver camera_device:chr_file { ioctl read write open };
allow phasecheckserver vendor_toolbox_exec:file execute_no_trans;
allow phasecheckserver prod_file:file create;
allow phasecheckserver proc:file { read write open };
allow phasecheckserver ufs_device:blk_file { read write open };
allow phasecheckserver sysfs_dpu_vendor:file { read open };
allow phasecheckserver sysfs_ddr_dfs:dir search;
allow phasecheckserver sysfs_ddr_dfs:file { read write open };
allow phasecheckserver sysfs_dpu_vsp:file { read open };
allow phasecheckserver sysfs_multipanel:file { read open };
allow phasecheckserver hwservicemanager:binder { call transfer };
allow phasecheckserver hwservicemanager_prop:file { read getattr map open };
allow phasecheckserver fwk_sensor_hwservice:hwservice_manager find;
allow phasecheckserver sysfs_sensor:file { read write open };
allow phasecheckserver ufs_device:blk_file { read getattr open };
allow phasecheckserver phasecheckserver_exec:file { read getattr map execute open entrypoint };
allow phasecheckserver teetz_device:chr_file { ioctl read write open };
