# Trusty HAL
type hal_trustyclientaidl_default, domain;
hal_server_domain(hal_trustyclientaidl_default, hal_trustyclientaidl)

type hal_trustyclientaidl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_trustyclientaidl_default)

hal_attribute_service(hal_trustyclientaidl, hal_trustyclientaidl_service)
binder_call(hal_trustyclientaidl_server, servicemanager)

allow hal_trustyclientaidl_default teetz_device:chr_file rw_file_perms;
