# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow mediacodec mediacodec_exec:file { read getattr map execute open entrypoint };
allow mediacodec vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow mediacodec vndservicemanager:binder { call transfer };
allow mediacodec gpu_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow mediacodec gpu_device:dir { ioctl read getattr lock open watch watch_reads search };
allow mediacodec ion_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow mediacodec dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow mediacodec video_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow mediacodec video_device:dir search;
allow mediacodec anr_data_file:file append;
allow mediacodec dumpstate:fd use;
allow mediacodec incidentd:fd use;
allow mediacodec dumpstate:fifo_file { write append };
allow mediacodec incidentd:fifo_file { write append };
allow mediacodec system_server:fifo_file { write append };
allow mediacodec tombstoned:unix_stream_socket connectto;
allow mediacodec tombstoned:fd use;
allow mediacodec tombstoned_crash_socket:sock_file write;
allow mediacodec tombstone_data_file:file append;
allow mediacodec aac_drc_prop:file { read getattr map open };
allow mediacodec system_file:dir { read open };
allow mediacodec video_device:chr_file { ioctl read write open };
allow mediacodec property_socket:sock_file write;
allow mediacodec init:unix_stream_socket connectto;
allow mediacodec vendor_video_prop:property_service set;
allow mediacodec vendor_video_prop:file { read getattr map open };
allow mediacodec vendor_audio_prop:file { read getattr open };
allow mediacodec vendor_data_file:dir { write create getattr open add_name remove_name search };
allow mediacodec vendor_data_file:file { read write create getattr open };
allow mediacodec debugfs_binder:file { read open };
allow mediacodec hal_trustyclientaidl_service:service_manager find;
allow mediacodec hal_trustyclientaidl_default:binder { call transfer };
allow mediacodec hal_trustyclientaidl_default:fd use;
allow mediacodec dts_audio_prop:file { read getattr map open };
allow mediacodec dts_audio_prop:file { read open };
