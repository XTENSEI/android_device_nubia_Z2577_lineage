# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_oemlock_default hal_oemlock_default_exec:file { read getattr map execute open entrypoint };
allow hal_oemlock_default sysfs:file { read write open };
allow hal_oemlock_default sysfs_ddr_dfs:file { read write getattr open };
allow hal_oemlock_default sysfs_ddr_dfs:dir { read getattr open search };
allow hal_oemlock_default teetz_device:chr_file { ioctl read write open };
