# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_bootctrl_default, domain;
hal_server_domain(hal_bootctrl_default, hal_bootctl)

type hal_bootctrl_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_bootctrl_default)

allow hal_bootctrl_default hal_bootctrl_default_exec:file { read getattr map execute open entrypoint };
allow hal_bootctrl_default hal_bootctl_hwservice:hwservice_manager { add find };
allow hal_bootctrl_default hwservicemanager_prop:file { read getattr map open };
allow hal_bootctrl_default hwservicemanager:binder { call transfer };
allow hal_bootctrl_default proc_cmdline:file { read getattr open };
allow hal_bootctrl_default sysfs_dt_firmware_android:dir search;
allow hal_bootctrl_default sysfs_dt_firmware_android:file { read getattr open };
allow hal_bootctrl_default mmcblk_device:blk_file { read write getattr open };
allow hal_bootctrl_default userdata_block_device:blk_file { read write getattr open };
allow hal_bootctrl_default metadata_file:dir search;
allow hal_bootctrl_default gsi_metadata_file:dir search;
allow hal_bootctrl_default block_device:dir search;
allow hal_bootctrl_default ufs_device:blk_file { read write getattr open };
allow hal_bootctrl_default gsi_metadata_file_type:dir search;
allow hal_bootctrl_default gsi_public_metadata_file:file { ioctl read getattr lock map open watch watch_reads };
allow hal_bootctrl_default proc_bootconfig:file { ioctl read getattr lock map open watch watch_reads };
allow hal_bootctrl_default proc_cmdline:file { ioctl read getattr lock map open watch watch_reads };
