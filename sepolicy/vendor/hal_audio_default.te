# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_audio_default hal_audio_default_exec:file { read getattr map execute open entrypoint };
allow hal_audio_default audioserver:fifo_file write;
allow hal_audio_default coredump_file:dir { read write getattr open add_name remove_name search };
allow hal_audio_default coredump_file:file { read write create getattr setattr unlink open };
allow hal_audio_default property_socket:sock_file write;
allow hal_audio_default init:unix_stream_socket connectto;
allow hal_audio_default vendor_audio_prop:file { read getattr map open };
allow hal_audio_default sysfs:file { read write getattr open };
allow hal_audio_default modem_control:unix_stream_socket { read write connectto };
allow hal_audio_default spipe_device:chr_file { ioctl read write open };
allow hal_audio_default rild:binder call;
allow hal_audio_default system_suspend_server:binder call;
allow hal_audio_default hal_extRadio_hwservice:hwservice_manager find;
allow hal_audio_default servicemanager:binder call;
allow hal_audio_default ext_radio_service:service_manager find;
allow hal_audio_default hal_power_default:binder { call transfer };
allow hal_audio_default sprd_audio_file:fifo_file { read write create getattr setattr open };
allow hal_audio_default sprd_audio_file:file { read write create getattr setattr append open };
allow hal_audio_default sprd_audio_file:dir { write getattr open add_name search };
allow hal_audio_default engpc:binder { call transfer };
allow hal_audio_default vendor_audio_prop:property_service set;
allow hal_audio_default sysfs_power:dir search;
allow hal_audio_default sysfs_power:file { read getattr open };
allow hal_audio_default spipe_device:chr_file ioctl;
allow hal_audio_default prod_file:dir { read getattr open search };
allow hal_audio_default prod_file:file { ioctl read write getattr setattr lock unlink open };
allow hal_audio_default vendor_product_prop:file { read getattr map open };
allow hal_audio_default block_device:dir search;
allow hal_audio_default mmcblk_device:blk_file { read open };
allow hal_audio_default ufs_device:blk_file { read open };
allow hal_audio_default userdata_block_device:blk_file { read open };
allow hal_audio_default mnt_vendor_file:dir { read write getattr open add_name search };
allow hal_audio_default mnt_vendor_file:file { ioctl read write create getattr setattr lock unlink open };
allow hal_audio_default system_suspend_hwservice:hwservice_manager find;
allow hal_audio_default hal_power_default:binder transfer;
allow hal_audio_default hal_power_default:fd use;
allow hal_audio_default boot_status_prop:file read;
allow hal_audio_default debugfs_reg:file { read open };
allow hal_audio_default audio_device:chr_file { ioctl read write open };
allow hal_audio_default audio_vendor_data_file:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_audio_default audio_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_audio_default sysfs_net:dir { ioctl read getattr lock open search };
allow hal_audio_default sysfs_net:file { read getattr open };
allow hal_audio_default sysfs:dir read;
allow hal_audio_default vendor_configs_file:file { ioctl lock };
allow hal_audio_default vendor_data_file:file { read write create getattr open };
allow hal_audio_default vendor_data_file:dir { write add_name };
allow hal_audio_default dts_audio_prop:file { read getattr map open };
allow hal_audio_default sysfs:file write;
allow hal_audio_default sysfs_leds:dir search;
allow hal_audio_default sysfs_leds:file { read write open };
allow hal_audio_default prod_file:file { read open };
allow hal_audio_default prod_file:dir search;
allow hal_audio_default sprd_audio_file:dir { read write create getattr unlink open add_name remove_name search rmdir };
