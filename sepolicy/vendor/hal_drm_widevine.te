# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_drm_widevine, domain;
hal_server_domain(hal_drm_widevine, hal_drm)

type hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_drm_widevine)

allow hal_drm_widevine hal_drm_widevine_exec:file { read getattr map execute open entrypoint };
allow hal_drm_widevine vndbinder_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_drm_widevine vndservicemanager:binder { call transfer };
allow hal_drm_widevine hal_allocator_server:fd use;
allow hal_drm_widevine mediadrm_vendor_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_drm_widevine mediadrm_vendor_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_drm_widevine map_device:chr_file { ioctl read write map open };
allow hal_drm_widevine dmabuf_system_heap_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow hal_drm_widevine hal_allocator:fd use;
allow hal_drm_widevine teetz_device:chr_file { ioctl read write open };
