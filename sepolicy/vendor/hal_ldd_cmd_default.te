# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_ldd_cmd_default, domain;
hal_server_domain(hal_ldd_cmd_default, hal_ldd_cmd)

type hal_ldd_cmd_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_ldd_cmd_default)

allow hal_ldd_cmd_default hal_ldd_cmd_default_exec:file { read getattr map execute open entrypoint };
allow hal_ldd_cmd_default battery_record_data_file:dir { read write create open add_name remove_name search };
allow hal_ldd_cmd_default battery_record_data_file:file { read write create getattr setattr append unlink open };
allow hal_ldd_cmd_default self:capability2 { syslog wake_alarm block_suspend };
allow hal_ldd_cmd_default vendor_data_file:dir { read write create append open add_name search };
allow hal_ldd_cmd_default vendor_data_file:file { read write create getattr setattr append unlink open };
allow hal_ldd_cmd_default vendor_charger_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_ldd_cmd_default vendor_charger_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_ldd_cmd_default tmpfs:chr_file relabelfrom;
allow hal_ldd_cmd_default kmsg_device:chr_file { write relabelto open };
allow hal_ldd_cmd_default tty_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_ldd_cmd_default self:netlink_kobject_uevent_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow hal_ldd_cmd_default mnt_vendor_file:dir { read open search };
allow hal_ldd_cmd_default mnt_vendor_file:lnk_file read;
allow hal_ldd_cmd_default vendor_file:dir { read open add_name remove_name search };
allow hal_ldd_cmd_default prod_file:dir { read write create open add_name remove_name search };
allow hal_ldd_cmd_default sysfs_power:dir { read open search };
allow hal_ldd_cmd_default sysfs_power:file { read write open };
allow hal_ldd_cmd_default sysfs:dir { read open search };
allow hal_ldd_cmd_default sysfs:file { read write open };
allow hal_ldd_cmd_default block_device:dir search;
allow hal_ldd_cmd_default sqc_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow hal_ldd_cmd_default sqc_device:chr_file { ioctl read write open };
allow hal_ldd_cmd_default oem_zte_misc:dir { read open search };
allow hal_ldd_cmd_default oem_zte_misc:file { read write open };
allow hal_ldd_cmd_default oem_blk_device:blk_file { read write lock open };
allow hal_ldd_cmd_default zte_ldd_tp_dev:chr_file { ioctl read write open };
