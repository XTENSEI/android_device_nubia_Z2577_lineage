# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_ai_engine_default, domain;

type hal_ai_engine_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_ai_engine_default)

allow hal_ai_engine_default hal_ai_engine_default_exec:file { read getattr map execute open entrypoint };
allow hal_ai_engine_default dumpstate:binder transfer;
allow hal_ai_engine_default servicemanager:binder { call transfer };
allow hal_ai_engine_default hal_ai_engine_service:service_manager { add find };
allow hal_ai_engine_default app_data_file:file { read write getattr };
allow hal_ai_engine_default platform_app:fd use;
allow hal_ai_engine_default system_app:binder transfer;
allow hal_ai_engine_default dev_vdsp:chr_file { ioctl read write map open };
allow hal_ai_engine_default prod_file:dir search;
allow hal_ai_engine_default system_app:fd use;
allow hal_ai_engine_default imgnna_device:chr_file { ioctl read write map open };
allow hal_ai_engine_default gpu_device:chr_file { ioctl read write getattr map open };
