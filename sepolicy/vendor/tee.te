# TEE
allow tee teetz_device:chr_file rw_file_perms;
allow tee ss_file:dir create_dir_perms;
allow tee ss_file:file create_file_perms;

# tsupplicant
allow tee vendor_tee_prop:property_service set;

# Storage proxy
allow tee mmcblk_device:chr_file rw_file_perms;
allow tee rpmb_socket:sock_file rw_file_perms;
allow tee vendor_storageproxyd_default_prop:property_service set;

# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow tee tee_exec:file { read getattr map execute open entrypoint };
allow tee self:capability dac_override;
allow tee self:cap_userns dac_override;
allow tee tee_device:chr_file { ioctl read write getattr lock append map open watch watch_reads };
allow tee tee_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow tee tee_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow tee self:netlink_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow tee self:netlink_generic_socket { read write create getattr setattr lock append map bind connect getopt setopt shutdown };
allow tee ion_device:chr_file { ioctl read getattr lock map open watch watch_reads };
allow tee sysfs_type:dir { ioctl read getattr lock open watch watch_reads search };
allow tee sysfs_type:file { ioctl read getattr lock map open watch watch_reads };
allow tee sysfs_type:lnk_file { ioctl read getattr lock map open watch watch_reads };
allow tee system_data_file:file { read getattr };
allow tee system_data_file:lnk_file { read getattr };
allow tee self:capability { dac_override setgid setuid sys_rawio };
allow tee mmcblk_device:blk_file { ioctl read write open };
allow tee mmcblk_device:chr_file { ioctl read write open };
allow tee userdata_block_device:blk_file { ioctl read write open };
allow tee prod_file:dir { read write open add_name search };
allow tee prod_file:file { read write create open };
allow tee ss_file:dir { read write open add_name remove_name search };
allow tee ss_file:file { read write create unlink open };
allow tee block_device:dir { read open search };
allow tee teetz_device:chr_file { ioctl read write open };
allow tee property_socket:sock_file write;
allow tee init:unix_stream_socket connectto;
allow tee vendor_storageproxyd_default_prop:property_service set;
allow tee vendor_storageproxyd_default_prop:file { read getattr map open };
allowxperm tee mmcblk_device:blk_file ioctl { 0xb300 0xb301 };
allowxperm tee userdata_block_device:blk_file ioctl { 0xb300 0xb301 };
allow tee self:capability { setgid setuid };
