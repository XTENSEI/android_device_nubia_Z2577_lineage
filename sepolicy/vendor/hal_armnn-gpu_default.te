# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_armnn-gpu_default, domain;
hal_server_domain(hal_armnn-gpu_default, hal_neuralnetworks)
typeattribute hal_armnn-gpu_default mlstrustedsubject;

type hal_armnn-gpu_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_armnn-gpu_default)

allow hal_armnn-gpu_default vendor_armnn-gpu_prop:file { read getattr map open };
allow hal_armnn-gpu_default armnn-gpu_device:chr_file { ioctl read write map open };
allow hal_armnn-gpu_default gpu_device:chr_file { ioctl read write getattr map open };
allow hal_armnn-gpu_default system_data_file:dir search;
allow hal_armnn-gpu_default hwservicemanager_prop:file { read getattr map open };
allow hal_armnn-gpu_default hidl_base_hwservice:hwservice_manager add;
allow hal_armnn-gpu_default hwservicemanager:binder { call transfer };
allow hal_armnn-gpu_default hal_neuralnetworks_hwservice:hwservice_manager add;
allow hal_armnn-gpu_default vndbinder_device:chr_file { ioctl read write map open };
allow hal_armnn-gpu_default vndservicemanager:binder { call transfer };
allow hal_armnn-gpu_default ion_device:chr_file { ioctl read write open };
allow hal_armnn-gpu_default device:chr_file ioctl;
allow hal_armnn-gpu_default device:dir { ioctl read write getattr lock open watch watch_reads add_name remove_name search };
allow hal_armnn-gpu_default hal_graphics_allocator_default_tmpfs:file { read write map };
allow hal_armnn-gpu_default prod_file:dir search;
allow hal_armnn-gpu_default vendor_arm_prop:file { read getattr map open };
allow hal_armnn-gpu_default hal_neuralnetworks_service:service_manager add;
allow hal_armnn-gpu_default hal_armnn-gpu_default_exec:file { read getattr map execute open entrypoint };
