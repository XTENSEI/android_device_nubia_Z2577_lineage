# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow hal_wifi_hostapd_default hal_wifi_hostapd_default_exec:file { read getattr map execute open entrypoint };
allow hal_wifi_hostapd_default hostapd_data_file:dir { ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir };
allow hal_wifi_hostapd_default hostapd_data_file:file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_wifi_hostapd_default hostapd_data_file:sock_file { ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads };
allow hal_wifi_hostapd_default hal_hostapd_hwservice:hwservice_manager add;
allow hal_wifi_hostapd_default vendor_data_file:dir search;
allow hal_wifi_hostapd_default vendor_data_file:file { read write open };
allow hal_wifi_hostapd_default prod_file:dir search;
allow hal_wifi_hostapd_default system_uniwifi_prop:file { read getattr map open };
