# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
allow rild rild_exec:file { read getattr map execute open entrypoint };
allow rild dumpstate:binder transfer;
allow rild vendor_radio_prop:property_service set;
allow rild servicemanager:binder { call transfer };
allow rild ext_radio_service:service_manager { add find };
allow rild platform_app:binder { call transfer };
allow rild net_eth0_prop:file { read getattr map open };
allow rild hal_secure_element_hwservice:hwservice_manager add;
allow rild hal_extRadio_hwservice:hwservice_manager { add find };
allow rild tty_device:chr_file { ioctl read write open };
allow rild modem_control:unix_stream_socket { read write sendto connectto };
allow rild modem_control:dir search;
allow rild modem_control:file { read write open };
allow rild zygote:dir search;
allow rild zygote:file { read write open };
allow rild system_server:dir search;
allow rild system_server:file { read write open };
allow rild vold:dir search;
allow rild vold:file { read write open };
allow rild sdcardd:dir search;
allow rild sdcardd:file { read write open };
allow rild device:dir remove_name;
allow rild device:lnk_file unlink;
allow rild untrusted_app:dir search;
allow rild untrusted_app:file { read write open };
allow rild kernel:dir search;
allow rild kernel:file { read write open };
allow rild hal_network_default:unix_stream_socket connectto;
allow rild hal_networkaidl_default:unix_stream_socket connectto;
allow rild servicemanager:dir search;
allow rild servicemanager:file { read write open };
allow rild ctl_default_prop:property_service set;
allow rild vendor_toolbox_exec:file execute_no_trans;
allow rild vendor_shell_exec:file execute_no_trans;
allow rild spipe_device:chr_file { read write open };
allow rild hal_extthermal_hwservice:hwservice_manager find;
allow rild property_socket:sock_file write;
allow rild init:unix_stream_socket connectto;
allow rild vendor_radio_prop:file { read getattr map open };
allow rild vendor_sys_prop:property_service set;
allow rild vendor_sys_prop:file { read getattr map open };
allow rild vendor_product_prop:property_service set;
allow rild vendor_product_prop:file { read getattr map open };
allow rild vendor_bt_prop:file { read getattr map open };
allow rild proc_cmdline:file { read open };
allow rild hal_power_default:binder { call transfer };
allow rild hal_thermal_ext:binder call;
allow rild embmsd:binder call;
allow rild system_app:binder call;
allow rild powerctl_prop:file { read open };
allow rild wcnd:unix_stream_socket { read connectto };
allow rild hal_networkaidl_default:binder call;
allow rild hal_networkaidl_service:service_manager find;
allow rild block_device:dir search;
allow rild mmcblk_device:blk_file { read write open };
allow rild ufs_device:blk_file { read write open };
allow rild teetz_device:chr_file { ioctl read write open };
allow rild vendor_jsonweb_system_prop:file { read getattr map open };
