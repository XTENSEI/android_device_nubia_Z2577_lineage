# From the stock odm_sepolicy.cil and vendor_sepolicy.cil
type hal_gnss_ext_default, domain;
hal_server_domain(hal_gnss_ext_default, hal_wifi_supplicant)
typeattribute hal_gnss_ext_default netdomain;

type hal_gnss_ext_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_gnss_ext_default)

allow hal_gnss_ext_default system_app:binder transfer;
allow hal_gnss_ext_default hal_gnss_ext_default_exec:file { read getattr map execute open entrypoint };
allow hal_gnss_ext_default coredump_file:dir { read write getattr open add_name remove_name search };
allow hal_gnss_ext_default coredump_file:file { read write create getattr setattr unlink open };
allow hal_gnss_ext_default hal_cplog_svcaidl_default:binder transfer;
allow hal_gnss_ext_default hal_extGnss_hwservice:hwservice_manager { add find };
allow hal_gnss_ext_default hal_extGnss_service:service_manager { add find };
allow hal_gnss_ext_default tty_device:chr_file { ioctl read write open };
allow hal_gnss_ext_default dnsproxyd_socket:sock_file write;
allow hal_gnss_ext_default netd:unix_stream_socket connectto;
allow hal_gnss_ext_default fwmarkd_socket:sock_file write;
allow hal_gnss_ext_default port:tcp_socket name_connect;
allow hal_gnss_ext_default hal_gnss_ext_default:tcp_socket { ioctl read write create bind connect getopt setopt };
allow hal_gnss_ext_default hal_gnss_ext_default:netlink_kobject_uevent_socket { read create bind getopt setopt };
allow hal_gnss_ext_default modem_control:unix_stream_socket { read write connectto };
allow hal_gnss_ext_default hal_gnss_ext_default:capability fowner;
allow hal_gnss_ext_default gnss_file:file { read getattr setattr open };
allow hal_gnss_ext_default sysfs_gnss:dir { read open search };
allow hal_gnss_ext_default sysfs_gnss:file { ioctl read write open };
allowxperm hal_gnss_ext_default sysfs_gnss:file ioctl { 0x540b };
allow hal_gnss_ext_default sysfs_gnss:lnk_file read;
allow hal_gnss_ext_default kernel:dir { write create open add_name remove_name search };
allow hal_gnss_ext_default kernel:file { read write create append open };
allow hal_gnss_ext_default prod_file:dir { write create open add_name remove_name search };
allow hal_gnss_ext_default prod_file:file { read write create append open };
allow hal_gnss_ext_default prod_file:file { read getattr setattr open };
allow hal_gnss_ext_default gnss_file:file write;
allow hal_gnss_ext_default gpsd:unix_stream_socket connectto;
allow hal_gnss_ext_default gpsd:unix_dgram_socket sendto;
allow hal_gnss_ext_default serial_device:chr_file { ioctl read write open };
allow hal_gnss_ext_default slogmodem_vendor:unix_stream_socket connectto;
allow hal_gnss_ext_default hal_cplog_connmgr_default:unix_stream_socket connectto;
allow hal_gnss_ext_default vndbinder_device:chr_file { ioctl read write open };
allow hal_gnss_ext_default wcn_device:chr_file { ioctl read write open };
allow hal_gnss_ext_default gnss_file:dir search;
allow hal_gnss_ext_default prod_file:dir search;
allow hal_gnss_ext_default gnss_file:dir { write add_name };
allow hal_gnss_ext_default gnss_file:file { create append };
allow hal_gnss_ext_default unlabeled:dir search;
allow hal_gnss_ext_default unlabeled:file { read write getattr open };
allow hal_gnss_ext_default wcnd:unix_stream_socket connectto;
allow hal_gnss_ext_default block_device:dir search;
allow hal_gnss_ext_default mmcblk_device:blk_file { read getattr open };
allow hal_gnss_ext_default userdata_block_device:blk_file { read getattr open };
allow hal_gnss_ext_default spipe_device:chr_file { read write open };
allow hal_gnss_ext_default mnt_vendor_file:dir { read write create open add_name remove_name search };
allow hal_gnss_ext_default mnt_vendor_file:file { read write create getattr setattr open };
allow hal_gnss_ext_default vendor_media_prop:file { read getattr open };
allow hal_gnss_ext_default vendor_radio_prop:file { read getattr open };
allow hal_gnss_ext_default vendor_audio_prop:file { read getattr open };
allow hal_gnss_ext_default vendor_media_prop:file { read getattr map open };
allow hal_gnss_ext_default vendor_audio_prop:file map;
allow hal_gnss_ext_default vendor_media_prop:file map;
allow hal_gnss_ext_default vendor_radio_prop:file map;
allow hal_gnss_ext_default vndbinder_device:chr_file map;
allow hal_gnss_ext_default property_socket:sock_file write;
allow hal_gnss_ext_default init:unix_stream_socket connectto;
allow hal_gnss_ext_default vendor_sys_prop:property_service set;
allow hal_gnss_ext_default sensors_device:chr_file { ioctl read write getattr lock append map execute open watch watch_reads execute_no_trans };
allow hal_gnss_ext_default vendor_sp_prop:file { read getattr map open };
allow hal_gnss_ext_default vendor_sp_prop:property_service set;
allow hal_gnss_ext_default vendor_sys_prop:file { read getattr map open };
allow hal_gnss_ext_default platform_app:binder transfer;
